@app.route('/login', methods=['POST'])
def login():
    username = request.form.get('username')
    password = request.form.get('password')
    
    # التحقق من صلاحيات المسؤول الخاص
    if username == "KF7" and password == "KF7_12345678":
        session['logged_in'] = True
        session['username'] = "KF7 (المسؤول)"
        session['is_admin'] = True
        admin_logs.append(f"تسجيل دخول المسؤول الرئيسي KF7 بنجاح.")
        return redirect(url_for('index'))
    
    elif username and password:
        session['logged_in'] = True
        session['username'] = username
        session['is_admin'] = False
        admin_logs.append(f"تسجيل دخول مستخدم جديد: {username}")
        return redirect(url_for('index'))
        
    return redirect(url_for('index'))

@app.route('/')
def index():
    if not session.get('logged_in'):
        return render_template_string(HTML_TEMPLATE)
    return render_template_string(HTML_TEMPLATE.replace('{% block content %}{% endblock %}', CHAT_TEMPLATE), history=chat_logs)

@app.route('/chat', methods=['POST'])
def chat():
    if not session.get('logged_in'):
        return redirect(url_for('index'))
        
    query = request.form.get('query', '').strip()
    
    # معالجة ذكية للردود بناءً على القواعد المخزنة والرد الافتراضي المخصص لتيم الكوافح
    ai_reply = ""
    query_lower = query.lower()
    
    # فحص الردود المخصصة
    matched = False
    for key, val in custom_responses.items():
        if key in query_lower:
            ai_reply = val
            matched = True
            break
            
    if not matched:
        # محاكاة تحليل ذكاء اصطناعي بحت لحل المسائل والاستفسارات باللغة العربية والإنجليزية
        if any(char.isalpha() for char in query) and not any('\u0600' <= c <= \u06ff for c in query):
            ai_reply = f"KF7 Analysis: I have processed your query ('{query}'). As an advanced pure AI model programmed by Team Al-Kawafih, I evaluated all logical and mathematical parameters to deliver this optimized solution."
        else:
            ai_reply = f"تحليل KF7 الذكي: لقد قمت بمعالجة مسألتك أو سؤالك ('{query}'). بصفتي نظام ذكاء اصطناعي بحت، قمت بفحص كافة المعطيات الرياضية والمنطقية لأقدم لك الإجابة الدقيقة."

    chat_logs.append({'user': session['username'], 'q': query, 'a': ai_reply})
    return redirect(url_for('index'))

@app.route('/admin', methods=['GET', 'POST'])
def admin():
    if not session.get('logged_in') or not session.get('is_admin'):
        return redirect(url_for('index'))
    return render_template_string(HTML_TEMPLATE.replace('{% block content %}{% endblock %}', ADMIN_TEMPLATE), admin_logs=admin_logs)

@app.route('/add_response', methods=['POST'])
def add_response():
    if session.get('is_admin'):
        trig = request.form.get('trigger')
        resp = request.form.get('response')
        if trig and resp:
            custom_responses[trig.lower()] = resp
            admin_logs.append(f"تم اضافة رد جديد بواسطة المسؤول للمفتاح: {trig}")
    return redirect(url_for('admin'))

@app.route('/logout')
def logout():
    session.clear()
    return redirect(url_for('index'))

